{
  "schemaVersion": 2,
  "hostCases": [
    {
      "mode": "sp6a",
      "manifestRequired": true,
      "argv": ["/bin/bash", "Scripts/phase1-lifecycle-qa.sh", "preflight", "{manifest}", "{attempt}"],
      "timeoutSeconds": 1200
    }
  ],
  "cases": [
    {
      "task": 1,
      "case": "happy",
      "argv": ["swift", "test", "--package-path", "Spikes", "--scratch-path", "{attempt}/build/spikes", "--filter", "CurrentBaselineTests/testHappy|Phase1QARunnerCliTests/testHappy"],
      "expectedKind": "xctest",
      "timeoutSeconds": 1200,
      "minTestCount": 2
    },
    {
      "task": 1,
      "case": "failure",
      "argv": ["swift", "test", "--package-path", "Spikes", "--scratch-path", "{attempt}/build/spikes", "--filter", "CurrentBaselineTests/testFailure|Phase1QARunnerCliTests/testFailure"],
      "expectedKind": "xctest",
      "timeoutSeconds": 1200,
      "minTestCount": 22
    },
    {
      "task": 2,
      "case": "happy",
      "argv": ["swift", "test", "--package-path", "Spikes", "--scratch-path", "{attempt}/build/spikes", "--filter", "CurrentReadinessTests/testHappy"],
      "expectedKind": "xctest",
      "timeoutSeconds": 1200,
      "minTestCount": 8
    },
    {
      "task": 2,
      "case": "failure",
      "argv": ["swift", "test", "--package-path", "Spikes", "--scratch-path", "{attempt}/build/spikes", "--filter", "CurrentReadinessTests/testFailure"],
      "expectedKind": "xctest",
      "timeoutSeconds": 1200,
      "minTestCount": 15
    },
    {
      "task": 6,
      "case": "happy",
      "argv": ["/bin/bash", "Scripts/phase1-lifecycle-qa.sh", "happy", "{attempt}"],
      "expectedKind": "xctest",
      "timeoutSeconds": 1200,
      "minTestCount": 8
    },
    {
      "task": 6,
      "case": "failure",
      "argv": ["/bin/bash", "Scripts/phase1-lifecycle-qa.sh", "failure", "{attempt}"],
      "expectedKind": "xctest",
      "timeoutSeconds": 1200,
      "minTestCount": 5
    },
    {
      "task": 5,
      "case": "happy",
      "argv": ["swift", "test", "--package-path", ".", "--scratch-path", "{attempt}/build/root", "--filter", "ProductBoundaryTests|DomainSchemaTests"],
      "expectedKind": "xctest",
      "timeoutSeconds": 1200,
      "minTestCount": 17
    },
    {
      "task": 5,
      "case": "failure",
      "argv": ["swift", "test", "--package-path", ".", "--scratch-path", "{attempt}/build/root", "--filter", "DomainSchemaTests/testFailure|ProductBoundaryTests/testFailure"],
